{
    "realm": "household",
    "enabled": true,
    "accessTokenLifespan": 300,
    "ssoSessionIdleTimeout": 86400,
    "ssoSessionMaxLifespan": 604800,
    "clientScopes": [
        {
            "name": "basic",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "false",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "sub",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-sub-mapper",
                    "config": {
                        "access.token.claim": "true",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "name": "profile",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "username",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-usermodel-attribute-mapper",
                    "config": {
                        "user.attribute": "username",
                        "claim.name": "preferred_username",
                        "jsonType.label": "String",
                        "access.token.claim": "true",
                        "id.token.claim": "true",
                        "introspection.token.claim": "true",
                        "userinfo.token.claim": "true"
                    }
                }
            ]
        },
        {
            "name": "catalog-mcp",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "audience catalog-mcp",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "config": {
                        "included.custom.audience": "catalog-mcp",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "name": "device-mcp",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "audience device-mcp",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "config": {
                        "included.custom.audience": "device-mcp",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        },
        {
            "name": "taste-mcp",
            "protocol": "openid-connect",
            "attributes": {
                "include.in.token.scope": "true",
                "display.on.consent.screen": "false"
            },
            "protocolMappers": [
                {
                    "name": "audience taste-mcp",
                    "protocol": "openid-connect",
                    "protocolMapper": "oidc-audience-mapper",
                    "config": {
                        "included.custom.audience": "taste-mcp",
                        "access.token.claim": "true",
                        "id.token.claim": "false",
                        "introspection.token.claim": "true"
                    }
                }
            ]
        }
    ],
    "clients": [
        {
            "clientId": "concierge-cli",
            "name": "Watch Concierge CLI",
            "publicClient": true,
            "standardFlowEnabled": true,
            "directAccessGrantsEnabled": false,
            "redirectUris": [
                "http://127.0.0.1:8765/callback"
            ],
            "attributes": {
                "pkce.code.challenge.method": "S256"
            },
            "optionalClientScopes": [
                "catalog-mcp",
                "device-mcp",
                "taste-mcp"
            ],
            "defaultClientScopes": [
                "basic",
                "profile"
            ]
        }
    ],
    "users": [
        {
            "id": "11111111-1111-4111-8111-111111111111",
            "username": "gaurav",
            "enabled": true,
            "email": "gaurav@household.test",
            "emailVerified": true,
            "firstName": "Gaurav",
            "lastName": "Test",
            "credentials": [
                {
                    "type": "password",
                    "value": "gaurav-dev-pass",
                    "temporary": false
                }
            ]
        },
        {
            "id": "22222222-2222-4222-8222-222222222222",
            "username": "mishika",
            "enabled": true,
            "email": "mishika@household.test",
            "emailVerified": true,
            "firstName": "Mishika",
            "lastName": "Test",
            "credentials": [
                {
                    "type": "password",
                    "value": "mishika-dev-pass",
                    "temporary": false
                }
            ]
        }
    ]
}